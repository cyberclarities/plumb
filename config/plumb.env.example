# Plumb settings and secrets.
# Copy this file to plumb.env in the same folder and fill it in.
# Docker reads it when the container starts; it is never copied into the image.
# Keep it private: on macOS/Linux run  chmod 600 config/plumb.env

# ---- Dashboard sign-in (required) --------------------------------------------
# Your browser asks for these when you open https://<this computer>:6443/
PLUMB_DASHBOARD_USER=plumb
PLUMB_DASHBOARD_PASSWORD=

# Names or IP addresses people will use to reach the dashboard, comma-separated.
# Used for the self-signed certificate created on first start. Example:
#   PLUMB_HOSTNAMES=plumb.example.org,192.168.1.50
PLUMB_HOSTNAMES=

# ---- One secret per site ----------------------------------------------------
# Generate each with:  docker compose run --rm plumb new-secret SITE_NAME
# The name is PLUMB_SECRET_ + the site's name in capitals, with dashes as underscores,
# unless that site sets "secret_env" in sites.json.
PLUMB_SECRET_ACMECORP=
PLUMB_SECRET_ACMECORP_STG=
PLUMB_SECRET_HARBOR=

# ---- Schedule and behavior (defaults are fine) -------------------------------
INTERVAL_HOURS=12
RETRY_MINUTES=30
WORKERS=8
REQUEST_TIMEOUT=30
HISTORY_KEEP=60
UNVERIFIED_IS_REVIEW=true
STALE_UPDATE_CHECK_DAYS=3

# Time zone for log timestamps (dashboard times show in each viewer's own time zone)
TZ=America/Chicago

# Preview with fake data before your sites are set up: set to 1, then back to 0
PLUMB_DEMO=0
