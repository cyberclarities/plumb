# Docker Compose settings for this folder. Copy to .env to use:
#
#     cp .env.example .env
#
# This is not where Plumb's settings live. Those, and every secret, stay in
# config/plumb.env. This file only tells Docker Compose which files to read.

# ─── Reverse proxy ────────────────────────────────────────────────────────────
# Default: Plumb serves HTTPS on host port 6443 itself. Leave COMPOSE_FILE
# commented out.
#
# Stile, the shared Nginx proxy (~/source/stile): uncomment the line below. Plumb
# stops publishing 6443 and nginx serves it on that port instead. Start
# Stile first. Details in compose.nginx.yaml.
#
# On Windows, use ; instead of : between the file names.
#COMPOSE_FILE=compose.yaml:compose.nginx.yaml

# Only change if you renamed the network in stile/.env (PROXY_NETWORK).
#STILE_NETWORK=stile_net
