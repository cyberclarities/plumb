# Copy to .env and fill in. Keep .env readable only by the service account (chmod 600).

# The list of sites to pull (see sites.example.json). No secrets go in that file.
SITES_FILE=./sites.json

# Where index.html and data/ get written. Point your web server here.
OUTPUT_DIR=./output

# One secret per site, generated with:  python3 collector.py --new-secret SITE_NAME
# The variable name defaults to PLUMB_SECRET_<SITE NAME IN CAPS> (dashes become underscores),
# or whatever the site's "secret_env" says in sites.json.
PLUMB_SECRET_ACMECORP=
PLUMB_SECRET_ACMECORP_STG=
PLUMB_SECRET_HARBOR=

# Parallel requests and per-request timeout (seconds)
WORKERS=8
REQUEST_TIMEOUT=30

# Used by the dashboard to show "next run" and flag stale data
INTERVAL_HOURS=12

# Snapshots kept in data/history (60 x 12h = 30 days)
HISTORY_KEEP=60

# true: an active plugin/theme with no verifiable published version puts the site in "Review"
# false: it is counted and shown, but doesn't change the site's status
UNVERIFIED_IS_REVIEW=true

# Flag a site whose own update check (wp-cron) hasn't run in this many days
STALE_UPDATE_CHECK_DAYS=3
